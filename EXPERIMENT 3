import numpy as np
import pandas as pd
from sklearn.experimental import enable_iterative_imputer  # Explicitly required for MICE
from sklearn.impute import IterativeImputer, SimpleImputer

# 1. CREATE SAMPLE DATA
# Setting up a dataset with numerical and categorical missing values
np.random.seed(42)
raw_data = {
    "Age": [25, 30, np.nan, 45, 22, 35, np.nan, 50],
    "Salary": [50000, 60000, 55000, np.nan, 40000, np.nan, 62000, 85000],
    "Experience": [2, 5, 3, 15, np.nan, 7, 6, np.nan],
    "Category": ["A", "B", "A", np.nan, "B", "B", np.nan, "A"],
}
df = pd.DataFrame(raw_data)

print("--- Original DataFrame with Missing Values ---")
print(df)
print("\n" + "=" * 50 + "\n")

# 2. UNIVARIATE IMPUTATION (NUMERICAL)
print("--- 1 & 2. Mean and Median Imputation ---")
mean_imputer = SimpleImputer(strategy="mean")
median_imputer = SimpleImputer(strategy="median")

df["Age_Mean"] = mean_imputer.fit_transform(df[["Age"]]).ravel()
df["Salary_Median"] = median_imputer.fit_transform(df[["Salary"]]).ravel()


# 3. MODE IMPUTATION (CATEGORICAL)
print("--- 3. Mode Imputation (Fixed ValueError: 2) ---")
mode_imputer = SimpleImputer(strategy="most_frequent")

# .ravel() flattens the 2D array output into 1D to prevent dimension errors
df["Category_Mode"] = mode_imputer.fit_transform(df[["Category"]]).ravel()


# 4. MICE IMPUTATION (MULTIVARIATE IMPUTATION BY CHAINED EQUATIONS)
print("--- 4. MICE Imputation ---")
# Select multiple numeric columns for MICE to find cross-column patterns
mice_cols = ["Age", "Salary", "Experience"]

mice_imputer = IterativeImputer(max_iter=10, random_state=42)

# MICE outputs a full 2D array matching the shape of input columns
mice_array = mice_imputer.fit_transform(df[mice_cols])

# Re-assign the completed arrays back into the DataFrame
df[[f"{col}_MICE" for col in mice_cols]] = mice_array


# DISPLAY THE FINAL CLEANED DATAFRAME
print("\n--- Final Consolidated DataFrame ---")
pd.set_option("display.max_columns", None)
pd.set_option("display.width", 1000)
print(df)




