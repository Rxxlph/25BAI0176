import numpy as np
import pandas as pd

data = np.arange(15, 30).reshape(5, 3)
dfx = pd.DataFrame(
    data,
    index=["apple", "banana", "kiwi", "grapes", "mango"],
    columns=["store1", "store2", "store3"],
)

dfx["store4"] = np.nan
dfx.loc["watermelon"] = np.arange(15, 19)
dfx.loc["oranges"] = np.nan
dfx["store5"] = np.nan

dfx["store4"] = dfx["store4"].astype(float)
dfx.at["apple", "store4"] = 20.0

print("--- Original Dataframe with NaNs ---")
print(dfx)

print("\n--- 1. dfx.isnull() ---")
print(dfx.isnull())

print("\n--- 2. dfx.notnull() ---")
print(dfx.notnull())

print("\n--- 3. Missing values per column ---")
print(dfx.isnull().sum())

print("\n--- 4. Total missing values in entire dataframe ---")
print(dfx.isnull().sum().sum())

print("\n--- 5. Count of valid (non-NaN) values per column ---")
print(dfx.count())

print("\n--- Filtering store4 non-null values using boolean indexing ---")
print(dfx.store4[dfx.store4.notnull()])

print("\n--- Dropping NaNs from store4 Series ---")
print(dfx.store4.dropna())

print("\n--- dfx.dropna() (Drops any row containing at least one NaN) ---")
print(dfx.dropna())

print("\n--- Dropping rows where ALL values are NaN ---")
print(dfx.dropna(how="all"))

print("\n--- Dropping columns where ALL values are NaN ---")
print(dfx.dropna(how="all", axis=1))

print("\n--- Keeping columns with at least 5 non-NaN values ---")
print(dfx.dropna(thresh=5, axis=1))

print("\n--- NumPy vs Pandas Mean with NaN ---")
ar1 = np.array([100, 200, np.nan, 300])
ser1 = pd.Series(ar1)
print(f"NumPy mean (returns NaN): {ar1.mean()}")
print(f"Pandas mean (ignores NaN): {ser1.mean()}")

print("\n--- Mathematical operations on dfx.store4 ---")
ser2 = dfx.store4
print(f"Sum of store4: {ser2.sum()}")
print(f"Mean of store4: {ser2.mean()}")
print("\nCumulative sum of store4:")
print(ser2.cumsum())

print("\n--- Filling all NaNs with 0 ---")
filledDf = dfx.fillna(0)
print(filledDf)

print("\n--- Mean comparison: Original vs Filled with 0 ---")
print("Original dfx.mean():")
print(dfx.mean(numeric_only=True))
print("\nFilled filledDf.mean():")
print(filledDf.mean(numeric_only=True))

print("\n--- Forward filling (ffill) on store4 ---")
print(dfx.store4.ffill())

print("\n--- Backward filling (bfill) on store4 ---")
print(dfx.store4.bfill())





