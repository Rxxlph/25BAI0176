import matplotlib.pyplot as plt
import seaborn as sns

# Set style
sns.set_theme(style="whitegrid")

# Clean dataframe for user view
df['Month'] = pd.to_datetime(df['Month'])
df['Year'] = df['Month'].dt.year
df['Month_Name'] = df['Month'].dt.strftime('%b')

# Create plot
plt.figure(figsize=(10, 5))
plt.plot(df['Month'], df['#Passengers'], color='#1f77b4', linewidth=2, label='Monthly Passengers')
plt.title('Air Passengers Trend (1949 - 1960)', fontsize=14, fontweight='bold', pad=15)
plt.xlabel('Year', fontsize=12)
plt.ylabel('Number of Passengers (in thousands)', fontsize=12)
plt.tight_layout()
plt.savefig('air_passengers_trend.png', dpi=300)
plt.close()
